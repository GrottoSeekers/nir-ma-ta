---
const navItems = [
  { href: "#story", label: "Story" },
  { href: "#menu", label: "Menu" },
  { href: "#reviews", label: "Reviews" },
  { href: "#find-us", label: "Find Us" },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href="#" class="brand">
      <img src="/images/logo.webp" alt="NIR-MA-TA Coffee" width="38" height="38" />
      <span class="brand-name">NIR&#8209;MA&#8209;TA</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a href="https://wa.me/6287860149337" target="_blank" rel="noopener noreferrer" class="btn btn-primary bar-cta">
      WhatsApp
    </a>

    <button class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="drawer" id="drawer">
    {navItems.map((item) => (
      <a href={item.href} data-drawer-link>{item.label}</a>
    ))}
    <a href="https://wa.me/6287860149337" target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-drawer-link>
      WhatsApp us
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }

  .brand img {
    border-radius: 8px;
  }

  .brand-name {
    font-family: "Baloo 2", sans-serif;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.01em;
  }

  .nav {
    display: flex;
    gap: 28px;
  }

  .nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-dim);
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: var(--red);
  }

  .bar-cta {
    height: 42px;
    min-height: 42px;
    padding: 0 20px;
    font-size: 0.9rem;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
  }

  .menu-toggle span {
    width: 22px;
    height: 2.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }

  .menu-toggle.is-open span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .menu-toggle.is-open span:nth-child(2) { opacity: 0; }
  .menu-toggle.is-open span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  .drawer {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 10px 24px 22px;
    background: #ffffff;
    border-bottom: 1px solid var(--line);
  }

  .drawer.open {
    display: flex;
  }

  .drawer a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    padding: 12px 4px;
    min-height: 44px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }

  .drawer .btn {
    margin-top: 10px;
    align-self: flex-start;
  }

  @media (max-width: 780px) {
    .nav, .bar-cta {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const drawer = document.getElementById("drawer");

  toggle?.addEventListener("click", () => {
    const isOpen = drawer?.classList.toggle("open");
    toggle.classList.toggle("is-open", Boolean(isOpen));
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  drawer?.querySelectorAll("[data-drawer-link]").forEach((link) => {
    link.addEventListener("click", () => {
      drawer.classList.remove("open");
      toggle?.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
