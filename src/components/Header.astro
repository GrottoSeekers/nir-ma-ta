---
const navItems = [
  { href: "#story", label: "Story" },
  { href: "#menu", label: "Menu" },
  { href: "#reviews", label: "Reviews" },
  { href: "#find", label: "Find us" },
];
---

<header class="site-header">
  <div class="bar wrap">
    <a href="#top" class="brand">
      <img src="/images/logo.webp" alt="NIR-MA-TA Coffee" width="40" height="40" />
      <span class="brand-name">NIR&#8209;MA&#8209;TA</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="actions">
      <a
        href="https://www.instagram.com/nir.ma.ta"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="NIR-MA-TA on Instagram"
        class="ig-btn"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"></path>
          <path d="M17.5 6.5h.01"></path>
        </svg>
      </a>
      <a href="https://www.google.com/maps/search/?api=1&query=NIR-MA-TA+COFFEE+Senggigi+Lombok" target="_blank" rel="noopener noreferrer" class="visit-btn">
        VISIT US
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    border-bottom: 2px solid var(--ink);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 16px 20px;
    flex-wrap: wrap;
    padding-top: 12px;
    padding-bottom: 12px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    flex: 0 0 auto;
    text-decoration: none;
    color: var(--ink);
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand img {
    width: 40px;
    height: 40px;
  }

  .brand-name {
    font-family: "Archivo Black", sans-serif;
    font-size: 17px;
    letter-spacing: -0.4px;
    color: var(--ink);
  }

  .nav {
    display: flex;
    gap: 14px 18px;
    margin-left: auto;
    flex-wrap: wrap;
    align-items: center;
  }

  .nav a {
    font-family: "Work Sans", sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--ink);
  }

  .nav a:hover {
    color: var(--red);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
  }

  .ig-btn {
    width: 38px;
    height: 38px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    transition: background var(--ease), border-color var(--ease), color var(--ease);
  }

  .ig-btn svg {
    width: 18px;
    height: 18px;
  }

  .ig-btn:hover {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
  }

  .visit-btn {
    display: inline-flex;
    align-items: center;
    background: var(--red);
    color: #fff;
    padding: 12px 22px;
    min-height: 46px;
    font-family: "Archivo", sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.4px;
    white-space: nowrap;
    transition: background var(--ease);
  }

  .visit-btn:hover {
    background: var(--ink);
    color: #fff;
  }

  @media (max-width: 780px) {
    .nav {
      order: 99;
      flex-basis: 100%;
      margin-left: 0;
    }
  }
</style>
