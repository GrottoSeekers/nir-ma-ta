---
const reviews = [
  {
    quote: "Genuinely the nicest coffee we've had in our 4 weeks in Indonesia! We had just been complaining that there didn't seem to be many good coffee places in Senggigi before we stumbled on Andy.",
    name: "Jon Wylie",
  },
  {
    quote: "Most authentic coffee experience in Senggigi!! A coffee on the road, makes everyone stop, have a chat with the locals only with good vibes!!! Andy makes this place feel special!",
    name: "Tiago Belles",
  },
  {
    quote: "The coffee is fantastic, so well made and for a great price. Lovely ambience and great service from the barista, constantly learning to improve his craft. His equipment is wonderful and cleverly modified.",
    name: "Judy Chang",
  },
  {
    quote: "Great specialty coffee, Andy is very professional, easy going and cheerful. You're in for some good time and a great cup.",
    name: "Itai Sapir",
  },
  {
    quote: "Already visited many times when he was selling on the street, my favorite place. Great coffee and super friendly owner!! From a street-barista to a coffeeshop-owner, congratulations!",
    name: "Nalu House Gili Trawangan",
  },
  {
    quote: "My first hand pressed cappuccino and WOW. If you love a good cup of coffee then give Andy a visit. He is also next to the bus stop close to Attara Inn.",
    name: "Abbas Jamie",
  },
];
---

<section class="section" id="reviews">
  <div class="wrap">
    <div class="reviews-head reveal">
      <span class="eyebrow">Reviews</span>
      <h2>Five stars, eighty-four times over.</h2>
      <div class="rating-badge">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span><strong>5.0</strong> average · 84 Google reviews</span>
      </div>
    </div>

    <div class="reviews-grid reveal-stagger">
      {reviews.map((r) => (
        <figure class="review card">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <blockquote>{r.quote}</blockquote>
          <figcaption>{r.name}</figcaption>
        </figure>
      ))}
    </div>

    <div class="reviews-footer reveal">
      <a
        href="https://www.google.com/maps/search/?api=1&query=NIR-MA-TA+COFFEE+Senggigi+Lombok"
        target="_blank"
        rel="noopener noreferrer"
        class="arrow-link"
      >
        Read all 84 reviews on Google →
      </a>
    </div>
  </div>
</section>

<style>
  .reviews-head {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 40px;
  }

  .rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    font-size: 0.95rem;
    color: var(--ink-dim);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .review {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .review .stars {
    font-size: 0.85rem;
  }

  .review blockquote {
    font-size: 0.96rem;
    color: var(--ink);
    line-height: 1.55;
    flex: 1;
  }

  .review figcaption {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--ink-dim);
  }

  .reviews-footer {
    text-align: center;
    margin-top: 36px;
  }

  .arrow-link {
    display: inline-block;
    font-weight: 700;
    color: var(--red);
    text-decoration: none;
    transition: transform 0.2s var(--ease);
  }

  .arrow-link:hover {
    transform: translateX(3px);
  }
</style>
