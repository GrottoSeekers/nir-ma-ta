---
const reviews = [
  { quote: "Genuinely the nicest coffee we've had in our four weeks in Indonesia.", name: "Jon Wylie" },
  { quote: "A coffee on the road that makes everyone stop and have a chat with the locals. Only good vibes.", name: "Tiago Belles" },
  { quote: "So well made, and for a great price. His equipment is wonderful and cleverly modified.", name: "Judy Chang" },
];
---

<section id="reviews" class="section">
  <div class="wrap">
    <div class="reviews-head">
      <span class="eyebrow">REVIEWS</span>
      <h2>What people say.</h2>
    </div>
    <div class="reviews-grid">
      {reviews.map((r) => (
        <figure class="review">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <blockquote>{r.quote}</blockquote>
          <figcaption>{r.name}</figcaption>
        </figure>
      ))}
    </div>
    <a
      href="https://www.google.com/maps/search/?api=1&query=NIR-MA-TA+COFFEE+Senggigi+Lombok"
      target="_blank"
      rel="noopener noreferrer"
      class="reviews-link"
    >
      READ THE REVIEWS ON GOOGLE →
    </a>
  </div>
</section>

<style>
  .reviews-head {
    max-width: 620px;
    margin-bottom: 48px;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 28px;
  }

  .review {
    margin: 0;
    border-top: 3px solid var(--red);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .stars {
    color: var(--red);
    letter-spacing: 2px;
    font-size: 14px;
  }

  .review blockquote {
    margin: 0;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--ink);
    text-wrap: pretty;
  }

  .review figcaption {
    font-family: "Archivo", sans-serif;
    font-weight: 700;
    font-size: 13.5px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--muted-grey);
    margin-top: auto;
  }

  .reviews-link {
    display: inline-block;
    margin-top: 44px;
    font-family: "Archivo", sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.5px;
    border-bottom: 2px solid var(--red);
    padding-bottom: 3px;
  }
</style>
