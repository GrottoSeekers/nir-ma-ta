---
const photos = [
  { src: "/images/cart-stickers.webp", alt: "The NIR-MA-TA cart, covered in stickers left by travellers from all over the world", tall: true },
  { src: "/images/coffee-flight.webp", alt: "Latte, espresso and sparkling water served on a wooden table at NIR-MA-TA" },
  { src: "/images/shop-1.webp", alt: "Inside the new NIR-MA-TA shop, with exposed brick and fresh flowers on the counter" },
  { src: "/images/street-hangout.webp", alt: "Customers sitting on stools chatting with Andi on the street in Senggigi", tall: true },
  { src: "/images/shop-3.webp", alt: "The espresso machine and counter at the NIR-MA-TA shop" },
  { src: "/images/shop-2.webp", alt: "The NIR-MA-TA shop counter and seating area" },
];
---

<section class="section section-raised" id="gallery">
  <div class="wrap">
    <div class="gallery-head reveal">
      <span class="eyebrow">The Vibe</span>
      <h2>From the cart to the counter.</h2>
    </div>

    <div class="gallery-grid reveal-stagger">
      {photos.map((p) => (
        <div class:list={["gallery-item", { tall: p.tall }]}>
          <img src={p.src} alt={p.alt} loading="lazy" width="1000" height={p.tall ? "1777" : "1200"} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-head {
    margin-bottom: 32px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 220px;
    gap: 14px;
  }

  .gallery-item {
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-item.tall {
    grid-row: span 2;
  }

  @media (max-width: 780px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 180px;
    }
  }

  @media (max-width: 500px) {
    .gallery-grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 160px;
    }
  }
</style>
