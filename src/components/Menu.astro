---
const coffee = [
  { name: "Orange Amer", hot: null, ice: 28000 },
  { name: "Palm Sugar", hot: 28000, ice: 30000 },
  { name: "Caramel", hot: 28000, ice: 30000 },
  { name: "Vanilla", hot: 28000, ice: 30000 },
  { name: "Latte", hot: 25000, ice: 28000 },
  { name: "Espresso", hot: 20000, ice: null },
  { name: "Cappuccino", hot: 25000, ice: 28000 },
  { name: "Flat White", hot: 25000, ice: null },
  { name: "Split", hot: 35000, ice: null },
  { name: "Indonesiano", hot: 25000, ice: 28000 },
];

const nonCoffee = [
  { name: "Chocolate", hot: 25000, ice: 28000 },
  { name: "Matcha", hot: 25000, ice: 28000 },
  { name: "Kombucha", hot: null, ice: 35000 },
];

const addOn = [
  { name: "Oat Milk", price: 10000 },
  { name: "Extra Shot", price: 10000 },
];

const fmt = (n: number | null) => (n === null ? "—" : `${(n / 1000).toLocaleString()}k`);
---

<section class="section section-raised" id="menu">
  <div class="wrap">
    <div class="menu-intro reveal">
      <span class="eyebrow">Menu</span>
      <h2>Hand-brewed, priced fairly.</h2>
      <p class="lead">All in Indonesian Rupiah (Rp). Local beans, ground and brewed to order.</p>
    </div>

    <div class="menu-tables reveal-stagger">
      <div class="menu-table card">
        <div class="menu-table-head">
          <span>Coffee</span>
          <span class="cols"><span>Hot</span><span>Ice</span></span>
        </div>
        {coffee.map((item) => (
          <div class="menu-row">
            <span class="item-name">{item.name}</span>
            <span class="cols">
              <span>{fmt(item.hot)}</span>
              <span>{fmt(item.ice)}</span>
            </span>
          </div>
        ))}
      </div>

      <div class="menu-side">
        <div class="menu-table card">
          <div class="menu-table-head">
            <span>Non Coffee</span>
            <span class="cols"><span>Hot</span><span>Ice</span></span>
          </div>
          {nonCoffee.map((item) => (
            <div class="menu-row">
              <span class="item-name">{item.name}</span>
              <span class="cols">
                <span>{fmt(item.hot)}</span>
                <span>{fmt(item.ice)}</span>
              </span>
            </div>
          ))}
        </div>

        <div class="menu-table card">
          <div class="menu-table-head single">
            <span>Add On</span>
          </div>
          {addOn.map((item) => (
            <div class="menu-row">
              <span class="item-name">{item.name}</span>
              <span class="single-price">{fmt(item.price)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .menu-intro {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 44px;
  }

  .menu-intro .lead {
    margin: 0 auto;
  }

  .menu-tables {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .menu-side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .menu-table {
    overflow: hidden;
  }

  .menu-table-head {
    background: var(--red);
    color: var(--on-red);
    font-family: "Baloo 2", sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
    padding: 16px 20px 10px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .menu-table-head.single {
    padding-bottom: 16px;
  }

  .menu-table-head .cols {
    display: flex;
    gap: 22px;
    font-family: "Work Sans", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .menu-table-head .cols span {
    width: 44px;
    text-align: right;
  }

  .menu-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
  }

  .menu-row:last-child {
    border-bottom: none;
  }

  .item-name {
    color: var(--ink);
  }

  .menu-row .cols {
    display: flex;
    gap: 22px;
    color: var(--red);
    font-variant-numeric: tabular-nums;
  }

  .menu-row .cols span {
    width: 44px;
    text-align: right;
  }

  .single-price {
    color: var(--red);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 780px) {
    .menu-tables {
      grid-template-columns: 1fr;
    }
  }
</style>
