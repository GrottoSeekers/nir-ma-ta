---
// Hotspot boxes are percentages of the real menu-card image (1414x2000),
// measured directly off that image so they land on the real rows.
const items = [
  { name: "Orange Amer", hot: null, ice: 28000, box: { left: 49.5, top: 24.75, width: 40.3, height: 3.4 } },
  { name: "Palm Sugar", hot: 28000, ice: 30000, box: { left: 49.5, top: 28.15, width: 40.3, height: 2.6 } },
  { name: "Caramel", hot: 28000, ice: 30000, box: { left: 49.5, top: 30.75, width: 40.3, height: 2.55 } },
  { name: "Vanilla", hot: 28000, ice: 30000, box: { left: 49.5, top: 33.3, width: 40.3, height: 2.5 } },
  { name: "Latte", hot: 25000, ice: 28000, box: { left: 49.5, top: 35.8, width: 40.3, height: 2.4 } },
  { name: "Espresso", hot: 20000, ice: null, box: { left: 49.5, top: 38.2, width: 40.3, height: 2.5 } },
  { name: "Cappuccino", hot: 25000, ice: 28000, box: { left: 49.5, top: 40.7, width: 40.3, height: 2.7 } },
  { name: "Flat White", hot: 25000, ice: null, box: { left: 49.5, top: 43.4, width: 40.3, height: 2.75 } },
  { name: "Split", hot: 35000, ice: null, box: { left: 49.5, top: 46.15, width: 40.3, height: 2.75 } },
  { name: "Indonesiano", hot: 25000, ice: 28000, box: { left: 49.5, top: 48.9, width: 40.3, height: 4.15 } },
  { name: "Chocolate", hot: 25000, ice: 28000, box: { left: 12.0, top: 62.35, width: 35.4, height: 2.5 } },
  { name: "Matcha", hot: 25000, ice: 28000, box: { left: 12.0, top: 64.85, width: 35.4, height: 2.8 } },
  { name: "Kombucha", hot: null, ice: 35000, box: { left: 12.0, top: 67.65, width: 35.4, height: 4.15 } },
  { name: "Oat Milk", hot: null, ice: null, single: 10000, box: { left: 12.0, top: 77.1, width: 35.4, height: 2.4 } },
  { name: "Extra Shot", hot: null, ice: null, single: 10000, box: { left: 12.0, top: 79.3, width: 35.4, height: 2.2 } },
];
---

<section class="section section-raised" id="menu">
  <div class="wrap">
    <div class="menu-intro reveal">
      <span class="eyebrow">Menu</span>
      <h2>Hand-brewed, priced fairly.</h2>
      <p class="lead">This is the real menu card from the shop. Tap any item to order it on WhatsApp.</p>
    </div>

    <div class="menu-card-wrap reveal">
      <img
        src="/images/menu-card.webp"
        alt="NIR-MA-TA menu card: coffee, non-coffee and add-ons with hot and ice prices in Rupiah"
        width="1414"
        height="2000"
        class="menu-image"
      />
      {items.map((item, i) => (
        <button
          type="button"
          class="hotspot"
          style={`left:${item.box.left}%; top:${item.box.top}%; width:${item.box.width}%; height:${item.box.height}%;`}
          data-index={i}
          aria-label={`Order ${item.name}`}
        ></button>
      ))}
    </div>

    <p class="menu-note">Tip: tap a row on the menu above.</p>
  </div>

  <div class="order-sheet" id="order-sheet" hidden>
    <div class="order-sheet-backdrop" id="order-backdrop"></div>
    <div class="order-sheet-panel" role="dialog" aria-modal="true" aria-labelledby="order-item-name">
      <button type="button" class="order-close" id="order-close" aria-label="Close">&times;</button>
      <span class="eyebrow" id="order-eyebrow">Order</span>
      <h3 id="order-item-name">Item</h3>
      <div class="order-options" id="order-options"></div>
    </div>
  </div>
</section>

<script define:vars={{ items }}>
  const sheet = document.getElementById("order-sheet");
  const backdrop = document.getElementById("order-backdrop");
  const closeBtn = document.getElementById("order-close");
  const nameEl = document.getElementById("order-item-name");
  const optionsEl = document.getElementById("order-options");
  const WHATSAPP_NUMBER = "6287860149337";

  function fmt(n) {
    return `Rp ${n.toLocaleString("id-ID")}`;
  }

  function waLink(itemName, variantLabel, price) {
    const text = `Hi! I'd like to order: ${itemName}${variantLabel ? ` (${variantLabel})` : ""} - ${fmt(price)}`;
    return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;
  }

  function openSheet(item) {
    nameEl.textContent = item.name;
    optionsEl.innerHTML = "";

    if (item.single) {
      const a = document.createElement("a");
      a.className = "btn btn-primary order-option";
      a.href = waLink(item.name, null, item.single);
      a.target = "_blank";
      a.rel = "noopener noreferrer";
      a.textContent = `Order on WhatsApp — ${fmt(item.single)}`;
      optionsEl.appendChild(a);
    } else {
      if (item.hot) {
        const a = document.createElement("a");
        a.className = "btn btn-primary order-option";
        a.href = waLink(item.name, "Hot", item.hot);
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = `Hot — ${fmt(item.hot)}`;
        optionsEl.appendChild(a);
      }
      if (item.ice) {
        const a = document.createElement("a");
        a.className = "btn btn-ghost order-option";
        a.href = waLink(item.name, "Ice", item.ice);
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = `Ice — ${fmt(item.ice)}`;
        optionsEl.appendChild(a);
      }
    }

    sheet.hidden = false;
    document.body.style.overflow = "hidden";
  }

  function closeSheet() {
    sheet.hidden = true;
    document.body.style.overflow = "";
  }

  document.querySelectorAll(".hotspot").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = items[Number(btn.dataset.index)];
      openSheet(item);
    });
  });

  backdrop.addEventListener("click", closeSheet);
  closeBtn.addEventListener("click", closeSheet);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !sheet.hidden) closeSheet();
  });
</script>

<style>
  .menu-intro {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 32px;
  }

  .menu-intro .lead {
    margin: 0 auto;
  }

  .menu-card-wrap {
    position: relative;
    max-width: 520px;
    margin: 0 auto;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .menu-image {
    width: 100%;
    display: block;
  }

  .hotspot {
    position: absolute;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  .hotspot:hover,
  .hotspot:focus-visible {
    background: rgba(233, 19, 15, 0.08);
    box-shadow: inset 0 0 0 2px var(--red);
    outline: none;
  }

  .menu-note {
    text-align: center;
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin-top: 16px;
  }

  .order-sheet[hidden] {
    display: none;
  }

  .order-sheet {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .order-sheet-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(23, 19, 16, 0.5);
  }

  .order-sheet-panel {
    position: relative;
    width: 100%;
    max-width: 480px;
    background: #ffffff;
    border-radius: 22px 22px 0 0;
    padding: 28px 24px 32px;
    box-shadow: 0 -20px 50px -20px rgba(0, 0, 0, 0.4);
    animation: slideUp 0.3s var(--ease);
  }

  @media (min-width: 640px) {
    .order-sheet {
      align-items: center;
    }
    .order-sheet-panel {
      border-radius: 22px;
      animation: popIn 0.25s var(--ease);
    }
  }

  @keyframes slideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.94); }
    to { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .order-sheet-panel {
      animation: none;
    }
  }

  .order-close {
    position: absolute;
    top: 16px;
    right: 18px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: var(--bg-raised);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ink-dim);
    cursor: pointer;
  }

  .order-sheet-panel h3 {
    font-size: 1.5rem;
    margin: 6px 0 20px;
  }

  .order-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .order-option {
    width: 100%;
  }
</style>
